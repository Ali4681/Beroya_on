{
  "name": "beroya-go-backend",
  "version": "0.1.0",
  "description": "Beroya Go — ride-hailing backend (NestJS + Prisma + PostgreSQL + Redis + Socket.IO + BullMQ)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/prisma-direct.cjs migrate deploy && prisma generate && node scripts/clean-dist.cjs && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/verify-prisma-dist.cjs",
    "postinstall": "prisma generate",
    "start": "node dist/main.js",
    "dev": "node scripts/run-dev.js",
    "start:prod": "npm run build && node dist/main.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/prisma-direct.cjs migrate dev",
    "prisma:deploy": "node scripts/prisma-direct.cjs migrate deploy",
    "prisma:reset": "node scripts/prisma-direct.cjs migrate reset --force",
    "seed": "ts-node prisma/seed.ts",
    "seed:radar": "ts-node prisma/seed-radar.ts",
    "swagger:export": "ts-node -r tsconfig-paths/register scripts/export-swagger.ts",
    "docs:gen-go-plans": "node scripts/gen-go-client-plans.cjs",
    "docs:validate-plans": "node scripts/validate-plan-coverage.cjs",
    "docs:export-gaps-pdf": "node scripts/export-gaps-pdf.cjs"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "h3-js": "^4.5.0",
    "ioredis": "^5.7.0",
    "joi": "^17.13.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "dotenv": "^16.6.1",
    "jest": "^29.7.0",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@prisma/client$": "<rootDir>/generated/prisma/client"
    },
    "modulePaths": [
      "<rootDir>"
    ]
  }
}
