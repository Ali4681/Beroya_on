// =====================================================================
// PHASE 9 — Customer Passport / Discounts (Ticket §23–25)
// =====================================================================

enum GoPassportScoreEventType {
  RIDE_COMPLETED
  DRIVER_RATING_1
  DRIVER_RATING_2
  DRIVER_RATING_3
  DRIVER_RATING_4
  DRIVER_RATING_5
  LATE_CANCELLATION
  /// Customer cancel after driver is en route or arrived (higher penalty than late).
  EN_ROUTE_CANCELLATION
  NO_SHOW
  CONFIRMED_COMPLAINT
  STREAK_BONUS
}

enum GoDriverPassportScoreEventType {
  RIDE_COMPLETED
  DRIVER_CANCELLED_RIDE
}

model GoCustomerPassportLevel {
  id                      String                   @id @default(uuid())
  level_order             Int                      @unique
  name_ar                 String
  name_en                 String?
  /// Short Arabic stamp phrase shown on the customer passport (e.g. «أنت استثنائي»).
  stamp_name_ar           String?                  @db.VarChar(40)
  /// English stamp phrase (optional).
  stamp_name_en           String?                  @db.VarChar(40)
  icon_storage_key        String?
  minimum_score           Int
  minimum_completed_rides Int
  /// How long a granted stamp stays valid. 0 days + 0 hours = no expiry.
  duration_days           Int                      @default(0)
  duration_hours          Int                      @default(0)
  is_active               Boolean                  @default(true)
  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt
  passports               GoCustomerPassport[]
  discount_codes          GoCustomerDiscountCode[]
  stamps                  GoCustomerPassportStamp[]

  @@map("go_customer_passport_levels")
}

model GoCustomerPassportConfig {
  id                      String   @id @default("default")
  initial_score           Int      @default(100)
  minimum_score           Int      @default(-100)
  maximum_score           Int      @default(1000)
  review_interval_minutes Int      @default(1440)
  updated_at              DateTime @updatedAt

  @@map("go_customer_passport_config")
}

model GoCustomerPassport {
  id               String                  @id @default(uuid())
  customer_id      String                  @unique
  customer         GoCustomerProfile       @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  hidden_score     Int
  current_level_id String
  current_level    GoCustomerPassportLevel @relation(fields: [current_level_id], references: [id])
  completed_rides  Int                     @default(0)
  current_streak   Int                     @default(0)
  created_at       DateTime                @default(now())
  updated_at       DateTime                @updatedAt

  @@map("go_customer_passports")
}

/// Collected passport stamp = a level the customer has reached at least once (kept after demotion).
model GoCustomerPassportStamp {
  id          String                  @id @default(uuid())
  customer_id String
  customer    GoCustomerProfile       @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  level_id    String
  level       GoCustomerPassportLevel @relation(fields: [level_id], references: [id], onDelete: Restrict)
  earned_at   DateTime                @default(now())
  /// Null = permanent. Set from the level duration when the stamp is granted.
  expires_at  DateTime?

  @@unique([customer_id, level_id])
  @@index([customer_id, earned_at])
  @@index([customer_id, expires_at])
  @@map("go_customer_passport_stamps")
}

model GoPassportScoreRule {
  id               String                   @id @default(uuid())
  event_type       GoPassportScoreEventType
  ride_category_id String?
  ride_category    GoRideCategory?          @relation(fields: [ride_category_id], references: [id])
  score_delta      Int
  is_active        Boolean                  @default(true)
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt

  @@unique([event_type, ride_category_id])
  @@map("go_passport_score_rules")
}

model GoPassportScoreLedger {
  id           String                   @id @default(uuid())
  customer_id  String
  customer     GoCustomerProfile        @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  event_type   GoPassportScoreEventType
  ride_id      String?
  ride         GoRide?                  @relation(fields: [ride_id], references: [id])
  delta        Int
  score_before Int
  score_after  Int
  metadata     Json?
  created_at   DateTime                 @default(now())

  @@index([customer_id, created_at])
  @@index([ride_id, event_type])
  @@map("go_passport_score_ledger")
}

model GoPassportStreakConfig {
  id                    String   @id @default("default")
  milestone_every_rides Int      @default(10)
  is_active             Boolean  @default(true)
  updated_at            DateTime @updatedAt

  @@map("go_passport_streak_config")
}

enum GoPassportRewardType {
  SCORE
  DISCOUNT_CODE
  SCORE_AND_DISCOUNT
}

model GoPassportMilestoneRewardConfig {
  id                      String               @id @default(uuid())
  milestone_multiple      Int                  @unique
  reward_type             GoPassportRewardType
  score_bonus             Int?
  discount_percentage     Decimal?             @db.Decimal(5, 2)
  /// Hours the issued discount code stays valid (720 = 30 days).
  discount_valid_hours    Int                  @default(720)
  requires_admin_approval Boolean              @default(true)
  is_active               Boolean              @default(true)

  @@map("go_passport_milestone_reward_configs")
}

enum GoPassportRewardGrantStatus {
  PENDING
  APPROVED
  REJECTED
}

model GoPassportRewardGrant {
  id             String                      @id @default(uuid())
  customer_id    String
  customer       GoCustomerProfile           @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  streak_value   Int
  reward_type    GoPassportRewardType
  status         GoPassportRewardGrantStatus @default(PENDING)
  approved_by_id String?
  approved_by    User?                       @relation("RewardGrantApprover", fields: [approved_by_id], references: [id])
  approved_at    DateTime?
  created_at     DateTime                    @default(now())
  discount_codes GoCustomerDiscountCode[]

  @@index([status, created_at])
  @@index([customer_id])
  @@map("go_passport_reward_grants")
}

enum GoDiscountCodeStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  CONSUMED
}

enum GoDiscountAudience {
  ALL
  CUSTOMERS
  STAMP
}

model GoCustomerDiscountCode {
  id                      String                       @id @default(uuid())
  audience                GoDiscountAudience           @default(CUSTOMERS)
  customer_id             String?
  customer                GoCustomerProfile?           @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  passport_level_id       String?
  passport_level          GoCustomerPassportLevel?     @relation(fields: [passport_level_id], references: [id])
  code                    String                       @unique
  name                    String
  /// Optional English display name (Ticket §25).
  name_en                 String?
  percentage              Decimal                      @db.Decimal(5, 2)
  maximum_discount_amount Decimal?                     @db.Decimal(18, 2)
  valid_from              DateTime
  expires_at              DateTime
  /// Total uses across all customers. Null = no total cap.
  usage_limit             Int?
  usage_count             Int                          @default(0)
  /// Only the first N distinct customers may use the code. Null = no cap on people.
  max_customers           Int?
  /// Uses allowed per customer. Null = no per-customer cap.
  per_customer_limit      Int?
  /// Only customers without a completed ride.
  new_users_only          Boolean                      @default(false)
  /// Governorate: the ride pickup must resolve to this branch.
  branch_id               String?
  branch                  GoBranch?                    @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  event_name              String?                      @db.VarChar(120)
  /// GeoJSON Polygon of the event venue; the ride pickup or destination must fall inside it.
  event_area              Json?
  immediate_allowed       Boolean                      @default(true)
  scheduled_allowed       Boolean                      @default(true)
  status                  GoDiscountCodeStatus         @default(ACTIVE)
  /// When false, the code stays hidden from GET /customer/discount-codes until the customer redeems it.
  listed                  Boolean                      @default(true)
  milestone_grant_id      String?
  milestone_grant         GoPassportRewardGrant?       @relation(fields: [milestone_grant_id], references: [id])
  created_by_id           String
  created_by              User                         @relation(fields: [created_by_id], references: [id])
  created_at              DateTime                     @default(now())
  updated_at              DateTime                     @updatedAt
  categories              GoCustomerDiscountCategory[]
  /// Services the code covers. Empty = DAILY only.
  services                GoDiscountCodeService[]
  reservations            GoRideDiscountReservation[]
  holders                 GoDiscountCodeCustomer[]
  redemptions             GoDiscountCodeRedemption[]

  @@index([customer_id, status])
  @@index([audience, passport_level_id])
  @@index([branch_id])
  @@map("go_customer_discount_codes")
}

/// Account-screen activation of a typed discount code (Ticket §23). Does not consume usage.
model GoDiscountCodeRedemption {
  id               String                 @id @default(uuid())
  customer_id      String
  customer         GoCustomerProfile      @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  discount_code_id String
  discount_code    GoCustomerDiscountCode @relation(fields: [discount_code_id], references: [id], onDelete: Cascade)
  redeemed_at      DateTime               @default(now())

  @@unique([customer_id, discount_code_id])
  @@index([customer_id, redeemed_at])
  @@map("go_discount_code_redemptions")
}

model GoDiscountCodeCustomer {
  id               String                 @id @default(uuid())
  discount_code_id String
  discount_code    GoCustomerDiscountCode @relation(fields: [discount_code_id], references: [id], onDelete: Cascade)
  customer_id      String
  customer         GoCustomerProfile      @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@unique([discount_code_id, customer_id])
  @@map("go_discount_code_customers")
}

model GoCustomerDiscountCategory {
  id               String                 @id @default(uuid())
  discount_code_id String
  discount_code    GoCustomerDiscountCode @relation(fields: [discount_code_id], references: [id], onDelete: Cascade)
  ride_category_id String
  ride_category    GoRideCategory         @relation(fields: [ride_category_id], references: [id])

  @@unique([discount_code_id, ride_category_id])
  @@map("go_customer_discount_categories")
}

model GoDiscountCodeService {
  discount_code_id String
  discount_code    GoCustomerDiscountCode @relation(fields: [discount_code_id], references: [id], onDelete: Cascade)
  service_code     GoServiceCode
  service          GoService              @relation(fields: [service_code], references: [code])

  @@id([discount_code_id, service_code])
  @@map("go_discount_code_services")
}

enum GoServiceCode {
  DAILY
  RENTAL
  AIRPORT
  ACCESSIBILITY
  INTERCITY
  TOURIST
  FLEET
  AMBULANCE
}

/// Service tile on the customer home. One row per code, created by migration.
model GoService {
  code                 GoServiceCode           @id
  name_ar              String                  @db.VarChar(60)
  name_en              String?                 @db.VarChar(60)
  /// Relative file under storage/service-images. Null when no image was uploaded.
  image_key            String?
  /// false = shown as "coming soon".
  is_available         Boolean                 @default(false)
  /// false = not listed to customers at all.
  is_visible           Boolean                 @default(true)
  sort_order           Int                     @default(0)
  /// Marketing badge text; shown when the customer has no discount code for the service.
  promotion_label_ar   String?                 @db.VarChar(40)
  /// When set with an active label: customer pays less by this %. Company absorbs — driver commission on gross.
  promotion_percentage Decimal?                @db.Decimal(5, 2)
  /// Null = no end date.
  promotion_expires_at DateTime?
  updated_at           DateTime                @updatedAt
  discount_codes       GoDiscountCodeService[]
  rides                GoRide[]

  @@map("go_services")
}

enum GoRideDiscountReservationStatus {
  RESERVED
  APPLIED
  RELEASED
}

model GoRideDiscountReservation {
  id               String                          @id @default(uuid())
  ride_id          String                          @unique
  ride             GoRide                          @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  discount_code_id String
  discount_code    GoCustomerDiscountCode          @relation(fields: [discount_code_id], references: [id])
  status           GoRideDiscountReservationStatus @default(RESERVED)
  reserved_at      DateTime                        @default(now())
  applied_at       DateTime?
  released_at      DateTime?

  @@map("go_ride_discount_reservations")
}

// =====================================================================
// PHASE 10 — Driver Passport Framework only (Ticket §27) — no score rules yet
// =====================================================================

model GoDriverPassportLevel {
  id               String             @id @default(uuid())
  level_order      Int                @unique
  name_ar          String
  name_en          String?
  icon_storage_key String?
  minimum_score    Int?
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  passports        GoDriverPassport[]

  @@map("go_driver_passport_levels")
}

model GoDriverPassport {
  id               String                        @id @default(uuid())
  driver_id        String                        @unique
  driver           GoDriverProfile               @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  hidden_score     Int                           @default(0)
  current_level_id String?
  current_level    GoDriverPassportLevel?        @relation(fields: [current_level_id], references: [id])
  completed_rides  Int                           @default(0)
  created_at       DateTime                      @default(now())
  updated_at       DateTime                      @updatedAt
  score_ledger     GoDriverPassportScoreLedger[]

  @@map("go_driver_passports")
}

model GoDriverPassportScoreRule {
  id          String                         @id @default(uuid())
  event_type  GoDriverPassportScoreEventType @unique
  score_delta Int
  is_active   Boolean                        @default(true)
  created_at  DateTime                       @default(now())
  updated_at  DateTime                       @updatedAt

  @@map("go_driver_passport_score_rules")
}

model GoDriverPassportScoreLedger {
  id           String                         @id @default(uuid())
  driver_id    String
  driver       GoDriverProfile                @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  passport_id  String
  passport     GoDriverPassport               @relation(fields: [passport_id], references: [id], onDelete: Cascade)
  event_type   GoDriverPassportScoreEventType
  ride_id      String?
  ride         GoRide?                        @relation(fields: [ride_id], references: [id])
  delta        Int
  score_before Int
  score_after  Int
  metadata     Json?
  created_at   DateTime                       @default(now())

  @@index([driver_id, created_at])
  @@index([ride_id, event_type])
  @@map("go_driver_passport_score_ledger")
}

/// HR employee file (desk «الموظفون»). All personal/contract fields optional; base_salary required.
model GoEmployee {
  id        String   @id @default(uuid())
  /// Optional link to desk login User.
  user_id   String?  @unique
  user      User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  branch_id String?
  branch    GoBranch? @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  // Personal
  full_name_ar       String?   @db.VarChar(200)
  full_name_en       String?   @db.VarChar(200)
  phone              String?   @db.VarChar(32)
  email              String?   @db.VarChar(254)
  date_of_birth      DateTime? @db.Date
  gender             String?   @db.VarChar(32)
  marital_status     String?   @db.VarChar(32)
  national_id        String?   @db.VarChar(64)
  nationality        String?   @db.VarChar(100)
  blood_type         String?   @db.VarChar(16)
  allergies          String?   @db.VarChar(500)
  address            String?   @db.VarChar(1000)
  emergency_contact  String?   @db.VarChar(200)
  emergency_phone    String?   @db.VarChar(32)

  // Employment / contract
  contract_number       String?   @unique @db.VarChar(64)
  contract_type         String?   @db.VarChar(32)
  employment_status     String?   @db.VarChar(32)
  start_date            DateTime? @db.Date
  decision_date         DateTime? @db.Date
  daily_hours           Decimal?  @db.Decimal(4, 1)
  work_days_per_week    Int?
  work_location         String?   @db.VarChar(300)
  confidentiality_notes String?   @db.VarChar(4000)
  allowances_json       Json?
  attachments_json      Json?
  signatures_json       Json?

  // Financial — base_salary is the only required field on create
  base_salary           Decimal  @db.Decimal(14, 2)
  salary_currency       String   @default("SYP") @db.VarChar(8)
  insurance_number      String?  @db.VarChar(64)
  commissions_json      Json?
  custody_json          Json?

  // Qualifications
  specialization       String? @db.VarChar(200)
  university            String? @db.VarChar(200)
  graduation_year       Int?
  skills                String? @db.VarChar(1000)
  certificates_json     Json?
  languages_json        Json?
  licenses_json         Json?

  // Documents (storage keys / metadata)
  documents_json        Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([branch_id, created_at])
  @@index([full_name_ar])
  @@map("go_employees")
}

/// Per-app white-label branding (id = customer | driver). Draft + published JSON.
model GoAppBranding {
  id             String   @id // customer | driver
  version        Int      @default(1)
  published_json Json
  draft_json     Json
  updated_at     DateTime @updatedAt

  @@map("go_app_branding")
}

/// Per-app public info for Flutter (id = customer | driver): support, legal, force-update.
model GoAppInfo {
  id                     String   @id // customer | driver
  support_phone          String?  @db.VarChar(32)
  support_whatsapp       String?  @db.VarChar(64)
  support_email          String?  @db.VarChar(254)
  terms_url              String?  @db.VarChar(500)
  privacy_url            String?  @db.VarChar(500)
  about_ar               String?  @db.VarChar(4000)
  min_supported_version  String   @default("1.0.0") @db.VarChar(32)
  latest_version         String   @default("1.0.0") @db.VarChar(32)
  updated_at             DateTime @updatedAt

  @@map("go_app_info")
}
