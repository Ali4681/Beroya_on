  ride_id         String          @unique
  ride            GoRide          @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  reserved_amount Decimal         @db.Decimal(18, 2)
  released_at     DateTime?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  @@index([driver_id, released_at])
  @@map("go_wallet_commission_holds")
}

enum GoCompensationType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum GoCompensationBearer {
  UNASSIGNED
  BEROYA
  DRIVER
  SPLIT
}

model GoRideCompensation {
  id                     String               @id @default(uuid())
  ride_id                String
  ride                   GoRide               @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  type                   GoCompensationType
