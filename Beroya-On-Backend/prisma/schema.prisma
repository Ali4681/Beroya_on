}

// =====================================================================
// Stores (POS) — prepaid store balances that recharge driver wallets
// =====================================================================

enum GoStoreStatus {
  ACTIVE
  SUSPENDED
}

enum GoStoreLedgerType {
  /// Balance allocated by the company.
  ADMIN_CREDIT
  /// Balance consumed by a driver wallet recharge (amount = driver credit, no fee).
  DRIVER_RECHARGE_DEBIT
  /// Balance restored by reversing a recharge.
  REVERSAL_CREDIT
  /// Authorised correction with a mandatory reason; `direction` says which way.
  ADMIN_ADJUSTMENT
}

enum GoLedgerDirection {
  CREDIT
  DEBIT
}

/// Authorised physical point of sale. `balance` is the single source of truth for what it can still recharge.
model GoStore {
  id                    String               @id @default(uuid())
  code                  String               @unique @db.VarChar(16)
  name                  String               @db.VarChar(120)
  owner_name            String               @db.VarChar(120)
  /// E.164 contact number of the owner. Not a login identifier.
  mobile_number         String               @db.VarChar(20)
  address               String?              @db.VarChar(300)
  latitude              Decimal?             @db.Decimal(10, 7)
  longitude             Decimal?             @db.Decimal(10, 7)
  branch_id             String
  branch                GoBranch             @relation(fields: [branch_id], references: [id])
  status                GoStoreStatus        @default(ACTIVE)
  status_reason         String?              @db.VarChar(300)
  status_changed_at     DateTime?
  /// Never negative (DB CHECK). Changes only together with a ledger row.
  balance               Decimal              @default(0) @db.Decimal(18, 2)
  currency              String               @default("SYP") @db.VarChar(3)
  low_balance_threshold Decimal              @default(100000) @db.Decimal(18, 2)
  /// Largest single recharge. Null = only the store balance limits it.
  max_recharge_amount   Decimal?             @db.Decimal(18, 2)
  created_by_id         String?
  created_by            User?                @relation("StoreCreator", fields: [created_by_id], references: [id])
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  operators             User[]               @relation("StoreOperators")
  ledger                GoStoreLedgerEntry[]

  @@index([branch_id])
  @@index([status])
  @@index([mobile_number])
  @@index([created_at])
  @@map("go_stores")
}

/// Append-only store balance history (DB trigger rejects UPDATE/DELETE).
/// A DRIVER_RECHARGE_DEBIT row *is* the POS recharge record; its wallet credit is `wallet_transaction`.
model GoStoreLedgerEntry {
  id                    String                     @id @default(uuid())
  reference             String                     @unique @db.VarChar(32)
  store_id              String
  store                 GoStore                    @relation(fields: [store_id], references: [id], onDelete: Restrict)
  type                  GoStoreLedgerType
  direction             GoLedgerDirection
  /// Always > 0 (DB CHECK); `direction` gives the sign.
  amount                Decimal                    @db.Decimal(18, 2)
  currency              String                     @default("SYP") @db.VarChar(3)
  balance_before        Decimal                    @db.Decimal(18, 2)
  balance_after         Decimal                    @db.Decimal(18, 2)
  driver_id             String?
  driver                GoDriverProfile?           @relation(fields: [driver_id], references: [id], onDelete: Restrict)
  wallet_transaction_id String?                    @unique
  wallet_transaction    GoDriverWalletTransaction? @relation(fields: [wallet_transaction_id], references: [id], onDelete: Restrict)
  /// The recharge this row reverses. Unique: a recharge can be reversed once.
  reversed_entry_id     String?                    @unique
  reversed_entry        GoStoreLedgerEntry?        @relation("StoreLedgerReversal", fields: [reversed_entry_id], references: [id], onDelete: Restrict)
  reversal              GoStoreLedgerEntry?        @relation("StoreLedgerReversal")
  idempotency_key       String?                    @db.VarChar(128)
  /// sha256 of the business payload, so a reused key with another driver/amount is rejected.
  request_hash          String?                    @db.VarChar(64)
  external_reference    String?                    @db.VarChar(80)
  note                  String?                    @db.VarChar(500)
  performed_by_id       String
  performed_by          User                       @relation("StoreLedgerActor", fields: [performed_by_id], references: [id], onDelete: Restrict)
  created_at            DateTime                   @default(now())

  @@unique([store_id, idempotency_key])
  @@index([store_id, created_at])
  @@index([type, created_at])
  @@index([driver_id, created_at])
  @@map("go_store_ledger_entries")
}

model GoCustomerWallet {
  id           String                        @id @default(uuid())
  customer_id  String                        @unique
  customer     GoCustomerProfile             @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  balance      Decimal                       @default(0) @db.Decimal(18, 2)
  created_at   DateTime                      @default(now())
  updated_at   DateTime                      @updatedAt
  transactions GoCustomerWalletTransaction[]

  @@map("go_customer_wallets")
}

model GoCustomerWalletTransaction {
  id                     String                       @id @default(uuid())
  wallet_id              String
  wallet                 GoCustomerWallet             @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  customer_id            String
  customer               GoCustomerProfile            @relation(fields: [customer_id], references: [id])
  ride_id                String?
  ride                   GoRide?                      @relation(fields: [ride_id], references: [id], onDelete: SetNull)
  type                   GoWalletTransactionType
  amount                 Decimal                      @db.Decimal(18, 2)
  balance_before         Decimal                      @db.Decimal(18, 2)
  balance_after          Decimal                      @db.Decimal(18, 2)
  reason                 String?
  /// Pair link for TRANSFER_IN ↔ TRANSFER_OUT (and similar).
  related_transaction_id String?
  related_transaction    GoCustomerWalletTransaction? @relation("CustomerWalletTxPair", fields: [related_transaction_id], references: [id], onDelete: SetNull)
  paired_transactions    GoCustomerWalletTransaction[] @relation("CustomerWalletTxPair")
  created_by_id          String?
  created_by             User?                        @relation("CustomerWalletActor", fields: [created_by_id], references: [id])
  created_at             DateTime                     @default(now())

  @@index([customer_id, created_at])
  @@index([wallet_id, created_at])
  @@index([ride_id])
  @@index([related_transaction_id])
  @@map("go_customer_wallet_transactions")
}

/// Recharge / voucher codes customers redeem via POST /customer/wallet/redeem.
model GoWalletVoucher {
  id                      String                @id @default(uuid())
  /// Stored uppercase (e.g. ABCD-EFGH-IJKL). Unique case-insensitive via normalization.
  code                    String                @unique @db.VarChar(32)
  amount                  Decimal               @db.Decimal(18, 2)
  currency                String                @default("SYP") @db.VarChar(3)
  status                  GoWalletVoucherStatus @default(UNUSED)
