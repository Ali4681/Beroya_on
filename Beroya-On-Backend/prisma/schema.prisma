  system_average_fare          Decimal          @default(5000) @db.Decimal(18, 2)
  low_balance_amount_enabled   Boolean          @default(true)
  low_balance_amount           Decimal?         @default(20000) @db.Decimal(18, 2)
  low_balance_rides_enabled    Boolean          @default(true)
  low_balance_remaining_rides  Int?             @default(3)
  /// Fixed wallet penalty when a driver cancels an assigned ride.
  driver_cancel_penalty_amount Decimal          @default(2000) @db.Decimal(18, 2)
  updated_at                   DateTime         @updatedAt

  @@map("go_wallet_config")
}

model GoDriverWallet {
  id                     String                      @id @default(uuid())
  driver_id              String                      @unique
  driver                 GoDriverProfile             @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  balance                Decimal                     @default(0) @db.Decimal(18, 2)
