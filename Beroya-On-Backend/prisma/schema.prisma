  @@index([driver_id, started_at])
  @@index([ended_at])
  @@map("go_driver_online_sessions")
}

enum GoDriverScoreBand {
  KEEP
  WATCH
  REPLACEABLE
}

/// Nightly composite score per driver; `day` is the incentive day the window ends on.
model GoDriverScoreSnapshot {
  id             String            @id @default(uuid())
  driver_id      String
  driver         GoDriverProfile   @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  branch_id      String?
  day            String            @db.VarChar(10)
  window_days    Int
  rating         Decimal?          @db.Decimal(3, 2)
  ratings_count  Int               @default(0)
  acceptance_pct Decimal?          @db.Decimal(5, 2)
  offers_count   Int               @default(0)
  online_hours   Decimal           @db.Decimal(8, 2)
  earnings       Decimal           @db.Decimal(18, 2)
  completed      Int
  cancel_pct     Decimal?          @db.Decimal(5, 2)
  score          Decimal           @db.Decimal(5, 2)
  band           GoDriverScoreBand
  /// Points per metric and the weights used.
  breakdown      Json
  created_at     DateTime          @default(now())

  @@unique([driver_id, day])
  @@index([day, score])
  @@map("go_driver_score_snapshots")
}

/// Goal campaign: complete `rides_required` rides inside [start_time, end_time) on `days_of_week` to earn `reward_amount`.
model GoGoalCampaign {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(120)
  /// HH:mm local. end_time before start_time = the window crosses midnight (belongs to the start day).
  start_time     String    @db.VarChar(5)
  end_time       String    @db.VarChar(5)
  /// 0 = Sunday … 6 = Saturday, of the start day. Empty = every day.
  days_of_week   Int[]     @default([])
  rides_required Int
  reward_amount  Decimal   @db.Decimal(18, 2)
  /// Null = every branch.
  branch_id      String?
  branch         GoBranch? @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  is_active      Boolean   @default(true)
  created_by_id  String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  grants GoDriverIncentiveGrant[]

  @@index([is_active])
  @@map("go_goal_campaigns")
}

/// Bookkeeping for scheduled incentive work: one row per streak day or campaign occurrence.
model GoIncentiveRun {
  id          String          @id @default(uuid())
  kind        GoIncentiveKind
  /// Day (YYYY-MM-DD) for streaks, campaignId:day for campaigns.
  period_key  String          @db.VarChar(80)
  /// Campaign start push sent.
  notified_at DateTime?
  settled_at  DateTime?
  stats       Json?
  created_at  DateTime        @default(now())

  @@unique([kind, period_key])
  @@map("go_incentive_runs")
}

/// One paid incentive. The unique key makes every grant idempotent.
model GoDriverIncentiveGrant {
  id                    String                    @id @default(uuid())
  driver_id             String
  driver                GoDriverProfile           @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  kind                  GoIncentiveKind
  ride_id               String?
  ride                  GoRide?                   @relation(fields: [ride_id], references: [id], onDelete: SetNull)
  campaign_id           String?
  campaign              GoGoalCampaign?           @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  /// Day key (YYYY-MM-DD) for streaks, campaignId:day for goals, ride id for ride bonuses.
  period_key            String                    @db.VarChar(80)
  amount                Decimal                   @db.Decimal(18, 2)
  wallet_transaction_id String                    @unique
  wallet_transaction    GoDriverWalletTransaction @relation(fields: [wallet_transaction_id], references: [id])
  metadata              Json?
  created_at            DateTime                  @default(now())

  @@unique([driver_id, kind, period_key])
  @@index([created_at])
  @@index([kind, created_at])
  @@map("go_driver_incentive_grants")
}

/// Commission base for final deduction (Ticket §44 — configurable, not hard-coded).
enum GoCommissionBase {
  GROSS_FINAL_FARE
  CUSTOMER_PAYABLE
}

model GoWalletConfig {
  id                           String           @id @default("default")
  minimum_initial_topup        Decimal          @default(10000) @db.Decimal(18, 2)
  commission_percentage        Decimal          @default(10) @db.Decimal(5, 2)
  commission_base              GoCommissionBase @default(GROSS_FINAL_FARE)
