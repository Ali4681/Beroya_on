// =====================================================================
// PHASE 8 — Wallet / Finance / Compensation (Ticket §19–20)
// =====================================================================

enum GoWalletTransactionType {
  TOP_UP
  COMMISSION_DEDUCTION
  REVERSAL
  ADJUSTMENT
  COMPENSATION_BEARER
  DRIVER_CANCEL_PENALTY
  RIDE_PAYMENT
  RIDE_REFUND
  /// Company-paid driver incentive (streak, goal campaign, ride bonus).
  INCENTIVE_BONUS
  /// Company pays the ride discount into the driver wallet so the driver is not short when the customer pays less.
  DISCOUNT_SUBSIDY
  /// Cash top-up at an authorised store. Linked 1:1 to a store ledger debit.
  POS_RECHARGE
  /// Peer transfer: debit on sender.
  TRANSFER_OUT
  /// Peer transfer: credit on recipient.
  TRANSFER_IN
}

enum GoWalletVoucherStatus {
  UNUSED
  REDEEMED
  EXPIRED
  DISABLED
}

enum GoIncentiveKind {
  STREAK_DAILY
  GOAL_CAMPAIGN
  RIDE_REJECTION
  RIDE_DISTANCE
  /// One-off staff grant from the desk to a specific driver.
  MANUAL
}

enum GoRideBonusStack {
  MAX
  SUM
}

/// Driver incentive settings (single row "default"). Days and hours are in `timezone`.
model GoIncentiveConfig {
  id                      String           @id @default("default")
  timezone                String           @default("Asia/Damascus") @db.VarChar(64)
  /// Rides shorter than this never count toward streaks, goals or ride bonuses.
  min_counted_distance_m  Int              @default(1000)
  /// Sum of all bonuses paid per day. Null = no cap. Grants past it are skipped and audited.
  daily_total_cap         Decimal?         @db.Decimal(18, 2)
  /// Night fare: customer surcharge for rides requested (or scheduled) inside [night_start, night_end).
  night_fare_enabled      Boolean          @default(false)
  night_start             String           @default("00:00") @db.VarChar(5)
  night_end               String           @default("07:00") @db.VarChar(5)
  night_fare_pct          Decimal          @default(20) @db.Decimal(5, 2)
  /// Empty = every category.
  night_category_ids      String[]         @default([])
  /// Rejection bonus: once `rejection_min_drivers` different drivers declined a ride, the accepting driver earns rejection_pct of the fare.
  rejection_enabled       Boolean          @default(false)
  rejection_min_drivers   Int              @default(5)
  rejection_pct           Decimal          @default(15) @db.Decimal(5, 2)
  rejection_cap           Decimal?         @db.Decimal(18, 2)
  /// Count offers left to expire as rejections.
  rejection_count_expired Boolean          @default(true)
  /// Distance bonus: pickup farther than distance_min_km from the branch centre.
  distance_enabled        Boolean          @default(false)
  distance_min_km         Decimal          @default(15) @db.Decimal(6, 2)
  distance_pct            Decimal          @default(10) @db.Decimal(5, 2)
  distance_cap            Decimal?         @db.Decimal(18, 2)
  /// When both apply: MAX pays the larger one, SUM pays both.
  ride_bonus_stack        GoRideBonusStack @default(MAX)
  /// Streak: `streak_rides` completed rides in a row with no decline / driver cancel pays `streak_amount` once per day.
  streak_enabled          Boolean          @default(false)
  streak_rides            Int              @default(3)
  streak_amount           Decimal          @default(25000) @db.Decimal(18, 2)
  /// Count offers left to expire as breaking the streak.
  streak_count_expired    Boolean          @default(true)
  /// Incentive day boundary (HH:mm). Day D runs from D at this time to D+1 at this time; streaks are paid when it ends.
  daily_close_time        String           @default("00:00") @db.VarChar(5)
  /// Composite driver score over the last `score_window_days`. Weights are relative (normalised by their sum).
  score_window_days       Int              @default(30)
  weight_rating           Decimal          @default(30) @db.Decimal(5, 2)
  weight_acceptance       Decimal          @default(25) @db.Decimal(5, 2)
  weight_hours            Decimal          @default(20) @db.Decimal(5, 2)
  weight_earnings         Decimal          @default(25) @db.Decimal(5, 2)
  /// Points removed per 100% driver-cancel rate. 0 = cancellations not scored.
  weight_cancel           Decimal          @default(0) @db.Decimal(5, 2)
  band_keep               Decimal          @default(75) @db.Decimal(5, 2)
  band_watch              Decimal          @default(50) @db.Decimal(5, 2)
  updated_at              DateTime         @updatedAt

  @@map("go_incentive_config")
}

enum GoOnlineSessionEnd {
  DRIVER_OFFLINE
  FORCED_OFFLINE
  STALE_LOCATION
}

/// Time a driver was available (ONLINE or BUSY). Open while ended_at is null.
model GoDriverOnlineSession {
  id         String              @id @default(uuid())
  driver_id  String
  driver     GoDriverProfile     @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  started_at DateTime            @default(now())
  ended_at   DateTime?
