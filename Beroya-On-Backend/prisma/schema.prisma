  redeemed_transaction_id String?
  created_by_id           String
  created_by              User                  @relation("WalletVoucherCreator", fields: [created_by_id], references: [id])
  note                    String?               @db.VarChar(500)
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt

  @@index([status, expires_at])
  @@index([redeemed_by_customer_id])
  @@map("go_wallet_vouchers")
}

model GoWalletCommissionHold {
  id              String          @id @default(uuid())
  driver_id       String
  driver          GoDriverProfile @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  wallet_id       String
