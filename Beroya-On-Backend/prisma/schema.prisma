model GoDriverWalletTransaction {
  id                      String                      @id @default(uuid())
  wallet_id               String
  wallet                  GoDriverWallet              @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  driver_id               String
  driver                  GoDriverProfile             @relation(fields: [driver_id], references: [id])
  type                    GoWalletTransactionType
  amount                  Decimal                     @db.Decimal(18, 2)
  balance_before          Decimal                     @db.Decimal(18, 2)
