generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// PHASE 0 — Platform Foundation
// =====================================================================

/// Fixed roles. No dynamic permissions system (Ticket §1.1, §1.2).
enum GoRole {
  CUSTOMER
  DRIVER
  CUSTOMER_SERVICE
  CUSTOMER_SERVICE_SUPERVISOR
  OPERATIONS
  WALLET_OPERATOR
  FINANCE
  ADMIN
  SUPER_ADMIN
  /// Authorised store (POS) cashier. Not staff: only sees its own store through `users.store_id`.
  STORE_OPERATOR
}

enum GoDevicePlatform {
  ANDROID
  IOS
  WEB
}

enum GoOtpPurpose {
  CUSTOMER_LOGIN
  DRIVER_LOGIN
  DRIVER_PHONE_CHANGE
}

enum GoIdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

/// Operational branch (Ticket §1.3, §1.4).
model GoBranch {
  id           String   @id @default(uuid())
  code         String   @unique
  name_ar      String
  name_en      String?
  is_active    Boolean  @default(true)
  /// GeoJSON Polygon/MultiPolygon for pickup → branch ownership. Null = not configured yet.
  service_area Json?
  /// City centre for the distance bonus. Null = centroid of service_area.
  center_lat   Decimal? @db.Decimal(10, 7)
  center_lng   Decimal? @db.Decimal(10, 7)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  users          User[]
  drivers               GoDriverProfile[]
  vehicles              GoVehicle[]
  rides                 GoRide[]
  alerts                GoOperationalAlert[]
  complaints            GoComplaint[]
  emergencies           GoEmergencySession[]
  cases                 GoRideCase[]
  discount_codes        GoCustomerDiscountCode[]
  goal_campaigns        GoGoalCampaign[]
  stores                GoStore[]
  phone_change_requests GoDriverPhoneChangeRequest[]
  employees             GoEmployee[]

  @@map("go_branches")
}

/// Single central user table. Customer/Driver Go profiles link to it (Ticket §1.2).
/// A phone may hold one account per role (e.g. the same person as CUSTOMER and DRIVER).
model User {
  id            String    @id @default(uuid())
  role          GoRole
  phone         String?
  email         String?   @unique
  password_hash String?
  full_name     String?
  /// Staff desk avatar under storage/staff-avatars. Null when no photo was uploaded.
  avatar_key    String?
  branch_id     String?
  branch        GoBranch? @relation(fields: [branch_id], references: [id])
  is_active     Boolean   @default(true)
  /// Soft-delete timestamp (Ticket §27). Phone is cleared so the number can re-register.
  deleted_at    DateTime?
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  sessions                   GoUserSession[]
  customerProfile            GoCustomerProfile?
  driverProfile              GoDriverProfile?
  claimedAlerts              GoOperationalAlert[]
  assignedComplaints         GoComplaint[]                 @relation("ComplaintAssignee")
  resolvedComplaints         GoComplaint[]                 @relation("ComplaintResolver")
  claimedSupportMessages     GoSupportMessage[]            @relation("SupportMessageClaimedBy")
  handledEmergencies         GoEmergencySession[]          @relation("EmergencyHandler")
  savedEmergencies           GoEmergencySession[]          @relation("EmergencySaver")
  deletedEmergencies         GoEmergencySession[]          @relation("EmergencyDeleter")
  closedCases                GoRideCase[]                  @relation("CaseCloser")
  authoredCaseNotes          GoRideCaseNote[]
  reviewedEntitlements       GoDriverEntitlement[]         @relation("EntitlementReviewer")
  walletTransactions         GoDriverWalletTransaction[]
  customerWalletTransactions GoCustomerWalletTransaction[] @relation("CustomerWalletActor")
  walletVouchersCreated      GoWalletVoucher[]             @relation("WalletVoucherCreator")
  compensationsCreated       GoRideCompensation[]          @relation("CompensationCreator")
  compensationsReviewed      GoRideCompensation[]          @relation("CompensationFinanceReviewer")
  discountCodesCreated       GoCustomerDiscountCode[]
  passportRewardApprovals    GoPassportRewardGrant[]       @relation("RewardGrantApprover")
  ratingsGiven               GoRideRating[]                @relation("RatingFromUser")
  ratingsReceived            GoRideRating[]                @relation("RatingToUser")
  pushTokens                 GoPushToken[]
  customerNotifications      GoCustomerNotification[]
  driverNotifications        GoDriverNotification[]
  notificationBroadcasts     GoNotificationBroadcast[]
  rideMessagesSent           GoRideMessage[]
  fuelPriceChanges           GoFuelPriceChange[]
  /// Set only for STORE_OPERATOR accounts. The POS API resolves the store from here, never from the request.
  store_id                   String?
  store                      GoStore?                      @relation("StoreOperators", fields: [store_id], references: [id])
  storesCreated              GoStore[]                     @relation("StoreCreator")
  storeLedgerEntries         GoStoreLedgerEntry[]          @relation("StoreLedgerActor")
  phoneChangeRequests        GoDriverPhoneChangeRequest[]  @relation("PhoneChangeRequestDriverUser")
  phoneChangeReviews         GoDriverPhoneChangeRequest[]  @relation("PhoneChangeRequestReviewer")
  employeeProfile            GoEmployee?

  @@unique([phone, role])
  @@index([role])
  @@index([branch_id])
  @@index([deleted_at])
  @@index([store_id])
  @@map("users")
}

model GoUserSession {
  id                 String            @id @default(uuid())
  user_id            String
  user               User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_token_hash String
  device_id          String?
  device_name        String?
  platform           GoDevicePlatform?
  ip                 String?
  user_agent         String?
  expires_at         DateTime
  revoked_at         DateTime?
  last_used_at       DateTime          @default(now())
  created_at         DateTime          @default(now())

  @@index([user_id])
  @@map("go_user_sessions")
}

/// Device push token for FCM (Ticket §38).
model GoPushToken {
  id         String           @id @default(uuid())
  user_id    String
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token      String           @unique
  platform   GoDevicePlatform
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  @@index([user_id])
  @@map("go_push_tokens")
}

enum GoPushDeliveryStatus {
  QUEUED
  SENT
  SKIPPED
  FAILED
}

model GoPushDelivery {
  id         String               @id @default(uuid())
  user_id    String
  event      String
  title      String
  body       String
  payload    Json?
  status     GoPushDeliveryStatus @default(QUEUED)
  error      String?
  created_at DateTime             @default(now())

  @@index([user_id, created_at])
  @@map("go_push_deliveries")
}

/// In-app customer notification inbox (Ticket §18 — badge + notifications screen).
model GoCustomerNotification {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event      String
  title      String    @db.VarChar(120)
  body       String    @db.VarChar(500)
  payload    Json?
  read_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, created_at])
  @@index([user_id, read_at])
  @@map("go_customer_notifications")
}

/// In-app driver notification inbox (driver home «الإشعارات»).
model GoDriverNotification {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event      String
  title      String    @db.VarChar(120)
  body       String    @db.VarChar(500)
  payload    Json?
  read_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, created_at])
  @@index([user_id, read_at])
  @@map("go_driver_notifications")
}

enum GoNotificationBroadcastStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

/// Admin broadcast log (immediate or scheduled).
model GoNotificationBroadcast {
  id             String                        @id @default(uuid())
  audience       String                        @db.VarChar(20)
  /// Optional segment within the audience (birthday, top orders, top rating, …).
  filter         String?                       @db.VarChar(40)
  /// Cap for ranked filters (top/bottom N). Null for birthday / full audience.
  audience_limit Int?
  title          String                        @db.VarChar(80)
  body           String                        @db.VarChar(280)
  status         GoNotificationBroadcastStatus @default(SCHEDULED)
  scheduled_at   DateTime?
  sent_at        DateTime?
  created_by_id  String
  created_by     User                          @relation(fields: [created_by_id], references: [id])
  devices_queued Int?
  inbox_count    Int?
  job_id         String?
  error          String?
  created_at     DateTime                      @default(now())
  updated_at     DateTime                      @updatedAt

  @@index([created_at])
  @@index([status, scheduled_at])
  @@index([created_by_id, created_at])
  @@map("go_notification_broadcasts")
}

/// Editable default copy for birthday (and similar) admin broadcasts. Single row `default`.
model GoNotificationConfig {
  id                      String   @id @default("default")
  customer_birthday_title String   @default("عيد ميلاد سعيد") @db.VarChar(80)
  customer_birthday_body  String   @default("كل عام وأنت بخير يا {name}! نتمنى لك يوماً سعيداً مع بيرويا.") @db.VarChar(280)
  driver_birthday_title   String   @default("عيد ميلاد سعيد") @db.VarChar(80)
  driver_birthday_body    String   @default("كل عام وأنت بخير يا {name}! شكراً لكونك جزءاً من عائلة بيرويا.") @db.VarChar(280)
  updated_at              DateTime @updatedAt

  @@map("go_notification_config")
}

model GoOtpRequest {
  id          String       @id @default(uuid())
  phone       String
  purpose     GoOtpPurpose
  code_hash   String
  attempts    Int          @default(0)
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime     @default(now())

  @@index([phone, purpose, created_at])
  @@map("go_otp_requests")
}

/// Unified internal audit log (Ticket §30).
model GoAuditLog {
  id            String   @id @default(uuid())
  actor_user_id String?
  actor_role    GoRole?
  branch_id     String?
  action        String
  entity_type   String
  entity_id     String
  metadata      Json?
  created_at    DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([actor_user_id, created_at])
  @@index([action, created_at])
  @@map("go_audit_logs")
}

/// Idempotency-Key storage for sensitive/financial endpoints (Ticket §42).
model GoIdempotencyKey {
  id              String              @id @default(uuid())
  key             String
  user_id         String
  method          String
  path            String
  request_hash    String
  status          GoIdempotencyStatus @default(IN_PROGRESS)
  response_status Int?
  response_body   Json?
  created_at      DateTime            @default(now())
  expires_at      DateTime

  @@unique([user_id, key])
  @@index([expires_at])
  @@map("go_idempotency_keys")
}

// =====================================================================
// PHASE 1 — Core Master Data
// =====================================================================

enum GoRideRequirementType {
  FEMALE_DRIVER
  CHILD_SEAT
  EXTRA_LUGGAGE
  ACCESSIBILITY
  /// Personal assistance during the trip (ACCESSIBILITY flows).
  PERSONAL_ASSISTANCE
  /// Wheelchair-accessible vehicle.
  WHEELCHAIR
}

enum GoDriverGender {
  MALE
  FEMALE
  UNSPECIFIED
}

/// EXTERNAL: owns their vehicle — created with vehicle + vehicle docs in the driver wizard.
/// BEROYA: company driver — vehicle is created on Vehicles page and linked later.
enum GoDriverKind {
  EXTERNAL
  BEROYA
}

enum GoLanguage {
  AR
  EN
}

enum GoDocumentType {
  LICENSE
  VEHICLE_REGISTRATION
  INSURANCE
  IDENTITY
}

model GoRideCategory {
  id                   String                       @id @default(uuid())
  code                 String                       @unique
  name_ar              String
  name_en              String?
  is_active            Boolean                      @default(true)
  sort_order           Int                          @default(0)
  max_passengers       Int                          @default(4)
  /// Relative file under storage/ride-category-images. Null when no image was uploaded.
  image_key            String?
  pricing              GoRidePricing?
  vehicles             GoVehicle[]
  vehicle_categories   GoVehicleRideCategory[]
  rides                GoRide[]
  passport_score_rules GoPassportScoreRule[]
  discount_categories  GoCustomerDiscountCategory[]
  created_at           DateTime                     @default(now())
  updated_at           DateTime                     @updatedAt

  @@map("go_ride_categories")
}

model GoRidePricing {
  id               String         @id @default(uuid())
  ride_category_id String         @unique
  ride_category    GoRideCategory @relation(fields: [ride_category_id], references: [id])
  base_fare        Decimal        @db.Decimal(18, 2)
  price_per_km     Decimal        @db.Decimal(18, 2)
  price_per_minute Decimal        @db.Decimal(18, 2)
  minimum_fare     Decimal        @db.Decimal(18, 2)
  currency         String         @default("SYP")
  is_active        Boolean        @default(true)
  /// AUTO follows fuel price changes; MANUAL keeps price_per_km fixed. Both can be edited by hand.
  per_km_mode      GoPerKmMode    @default(AUTO)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  @@map("go_ride_pricing")
}

enum GoPerKmMode {
  AUTO
  MANUAL
}

/// Fuel price that drives AUTO per-km prices (single row "default").
model GoFuelPricing {
  id             String   @id @default("default")
  /// Null until the first fuel price is entered.
  current_price  Decimal? @db.Decimal(18, 2)
  /// Share of the per-km price caused by fuel, in percent. 100 = per-km moves by the same % as fuel.
  fuel_share_pct Decimal  @default(100) @db.Decimal(5, 2)
  /// New per-km prices are rounded to the nearest multiple of this. 0 = no rounding.
  rounding_step  Decimal  @default(50) @db.Decimal(18, 2)
  updated_at     DateTime @updatedAt

  @@map("go_fuel_pricing")
}

/// History of fuel price changes and the per-km prices they moved.
model GoFuelPriceChange {
  id             String   @id @default(uuid())
  old_price      Decimal? @db.Decimal(18, 2)
  new_price      Decimal  @db.Decimal(18, 2)
  fuel_share_pct Decimal  @db.Decimal(5, 2)
  rounding_step  Decimal  @db.Decimal(18, 2)
  changed_by_id  String?
  changed_by     User?    @relation(fields: [changed_by_id], references: [id], onDelete: SetNull)
  /// [{ ride_category_id, code, name_ar, old_per_km, new_per_km }]
  affected       Json
  created_at     DateTime @default(now())

  @@index([created_at])
  @@map("go_fuel_price_changes")
}

/// Ride package shown on the customer home. Offers ride_count rides and/or discount_percentage off for duration_days.
model GoPackage {
  id                  String   @id @default(uuid())
  name_ar             String   @db.VarChar(80)
  name_en             String?  @db.VarChar(80)
  description_ar      String?  @db.VarChar(500)
  description_en      String?  @db.VarChar(500)
  price               Decimal  @db.Decimal(18, 2)
  currency            String   @default("SYP") @db.VarChar(3)
  duration_days       Int
  ride_count          Int?
  discount_percentage Decimal? @db.Decimal(5, 2)
  /// Relative file under storage/package-images. Null when no image was uploaded.
  image_key           String?
  is_active           Boolean  @default(true)
  sort_order          Int      @default(0)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([is_active, sort_order])
  @@map("go_packages")
}

/// Customer-selectable city (Ticket §21). Operational branches stay on GoBranch.
model GoCity {
  id         String              @id @default(uuid())
  name_ar    String              @unique @db.VarChar(80)
  name_en    String?             @db.VarChar(80)
  /// Governorate / city centroid for INTERCITY map pin (optional until admin sets it).
  lat        Float?
  lng        Float?
  sort_order Int                 @default(0)
  is_active  Boolean             @default(true)
  created_at DateTime            @default(now())
  updated_at DateTime            @updatedAt
  customers  GoCustomerProfile[]

  @@index([is_active, sort_order])
  @@map("go_cities")
}

/// Customer Go profile linked to central User (Ticket §1.2).
model GoCustomerProfile {
  id                   String                        @id @default(uuid())
  user_id              String                        @unique
  user                 User                          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  notes                String?
  /// Contact email set by the customer. Kept off User.email, which is unique and used for staff login.
  email                String?                       @db.VarChar(254)
  /// Legacy free-text city; kept for transition. API `city` prefers selected_city.name_ar.
  city                 String?                       @db.VarChar(80)
  city_id              String?
  selected_city        GoCity?                       @relation(fields: [city_id], references: [id], onDelete: SetNull)
  gender               GoDriverGender                @default(UNSPECIFIED)
  date_of_birth        DateTime?                     @db.Date
  preferred_currency   String                        @default("SYP") @db.VarChar(3)
  /// App / push / copy language preference (Ticket §25).
  preferred_language   GoLanguage                    @default(AR)
  /// Relative file under storage/customer-avatars. Null when no avatar was uploaded.
  avatar_key           String?
  rides                GoRide[]                      @relation("CustomerRides")
  complaints           GoComplaint[]
  support_messages     GoSupportMessage[]
  emergencies          GoEmergencySession[]
  cases                GoRideCase[]
  passport             GoCustomerPassport?
  score_ledger         GoPassportScoreLedger[]
  discount_codes       GoCustomerDiscountCode[]
  discount_memberships GoDiscountCodeCustomer[]
  discount_redemptions GoDiscountCodeRedemption[]
  reward_grants        GoPassportRewardGrant[]
  passport_stamps      GoCustomerPassportStamp[]
  saved_places         GoCustomerSavedPlace[]
  wallet               GoCustomerWallet?
  wallet_transactions  GoCustomerWalletTransaction[]
  redeemed_vouchers    GoWalletVoucher[]
  created_at           DateTime                      @default(now())
  updated_at           DateTime                      @updatedAt

  @@index([city_id])
  @@index([date_of_birth])
  @@map("go_customer_profiles")
}

enum GoSavedPlaceKind {
  HOME
  WORK
  OTHER
}

/// Customer saved places (home / work / other). Synced across devices (Ticket §22).
model GoCustomerSavedPlace {
  id          String            @id @default(uuid())
  customer_id String
  customer    GoCustomerProfile @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  name        String            @db.VarChar(60)
  /// Lowercased trimmed name for per-customer uniqueness.
  name_key    String            @db.VarChar(60)
  kind        GoSavedPlaceKind  @default(OTHER)
  lat         Decimal           @db.Decimal(10, 7)
  lng         Decimal           @db.Decimal(10, 7)
  address     String?           @db.VarChar(255)
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  @@unique([customer_id, name_key])
  @@index([customer_id, updated_at])
  @@map("go_customer_saved_places")
}

model GoDriverProfile {
  id                    String                        @id @default(uuid())
  user_id               String                        @unique
  user                  User                          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  branch_id             String?
  branch                GoBranch?                     @relation(fields: [branch_id], references: [id])
  gender                GoDriverGender                @default(UNSPECIFIED)
  /// EXTERNAL brings a vehicle in the create wizard; BEROYA gets a vehicle from /admin/vehicles.
  kind                  GoDriverKind                  @default(EXTERNAL)
  /// Optional birthday for admin birthday filters / dashboard (same shape as customer).
  date_of_birth         DateTime?                     @db.Date
  /// Primary / mother tongue as ISO 639-1 (e.g. ar, en, fr). Also included in `languages`.
  mother_tongue         String                        @default("ar") @db.VarChar(16)
  /// Spoken languages as ISO 639-1 codes (includes mother_tongue).
  languages             String[]                      @default([])
  /// App UI language (push / inbox copy). Distinct from spoken `languages`.
  preferred_language    GoLanguage                    @default(AR)
  is_suspended          Boolean                       @default(false)
  support_messages      GoSupportMessage[]
  suspended_reason      String?
  operational_blocked   Boolean                       @default(false)
  operational_reason    String?
  /// Relative file under storage/driver-avatars. Null when no photo was uploaded.
  avatar_key            String?
  active_vehicle_id     String?                       @unique
  active_vehicle        GoVehicle?                    @relation("DriverActiveVehicle", fields: [active_vehicle_id], references: [id])
  vehicles              GoVehicle[]                   @relation("DriverOwnedVehicles")
  documents             GoDriverDocument[]
  vehicle_photos        GoDriverVehiclePhoto[]
  state                 GoDriverState?
  rides                 GoRide[]                      @relation("DriverRides")
  offers                GoRideOffer[]
  complaints            GoComplaint[]
  cases                 GoRideCase[]
  entitlements          GoDriverEntitlement[]
  wallet                GoDriverWallet?
  wallet_transactions   GoDriverWalletTransaction[]
  commission_holds      GoWalletCommissionHold[]
  passport              GoDriverPassport?
  passport_score_ledger GoDriverPassportScoreLedger[]
  incentive_grants      GoDriverIncentiveGrant[]
  online_sessions       GoDriverOnlineSession[]
  score_snapshots       GoDriverScoreSnapshot[]
  store_ledger_entries  GoStoreLedgerEntry[]
  phone_change_requests GoDriverPhoneChangeRequest[]
  created_at            DateTime                      @default(now())
  updated_at            DateTime                      @updatedAt

  @@index([branch_id])
  @@index([date_of_birth])
  @@map("go_driver_profiles")
}

enum GoDriverPhoneChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  /// Applied immediately by desk staff (no OTP / no approval queue).
  STAFF_APPLIED
}

/// OTP proves ownership of the new number; staff approve/reject before User.phone is updated.
model GoDriverPhoneChangeRequest {
  id              String                    @id @default(uuid())
  driver_id       String
  driver          GoDriverProfile           @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  user_id         String
  user            User                      @relation("PhoneChangeRequestDriverUser", fields: [user_id], references: [id], onDelete: Cascade)
  branch_id       String?
  branch          GoBranch?                 @relation(fields: [branch_id], references: [id])
  current_phone   String
  requested_phone String
  status          GoDriverPhoneChangeStatus @default(PENDING)
  otp_verified_at DateTime
  reviewed_by_id  String?
  reviewed_by     User?                     @relation("PhoneChangeRequestReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  reviewed_at     DateTime?
  reject_reason   String?                   @db.VarChar(255)
  created_at      DateTime                  @default(now())
  updated_at      DateTime                  @updatedAt

  @@index([status, created_at])
  @@index([driver_id, status])
  @@index([branch_id, status])
  @@map("go_driver_phone_change_requests")
}

model GoDriverDocument {
  id             String          @id @default(uuid())
  driver_id      String
  driver         GoDriverProfile @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  type           GoDocumentType
  expires_at     DateTime?
  is_valid       Boolean         @default(true)
  /// Relative file under storage/driver-documents. Null when no front photo was uploaded.
  image_key      String?
  /// Back of the document. Null when no back photo was uploaded.
  image_back_key String?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  @@unique([driver_id, type])
  @@index([driver_id])
  @@map("go_driver_documents")
}

/// Car photos collected at driver onboarding (2–6). Relative file under storage/driver-vehicle-photos.
model GoDriverVehiclePhoto {
  id         String          @id @default(uuid())
  driver_id  String
  driver     GoDriverProfile @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  image_key  String
  sort_order Int             @default(0)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt

  @@index([driver_id, sort_order])
  @@map("go_driver_vehicle_photos")
}

model GoVehicle {
  id               String                  @id @default(uuid())
  branch_id        String?
  branch           GoBranch?               @relation(fields: [branch_id], references: [id])
  driver_id        String?
  driver           GoDriverProfile?        @relation("DriverOwnedVehicles", fields: [driver_id], references: [id])
  active_for       GoDriverProfile?        @relation("DriverActiveVehicle")
  /// Primary category (first of ride_categories). Kept for list/display compat.
  ride_category_id String?
  ride_category    GoRideCategory?         @relation(fields: [ride_category_id], references: [id])
  plate_number     String                  @unique
  make             String?
  model            String?
  color            String?
  year             Int?
  is_active        Boolean                 @default(true)
  capabilities     GoVehicleCapability[]
  ride_categories  GoVehicleRideCategory[]
  rides            GoRide[]
  created_at       DateTime                @default(now())
  updated_at       DateTime                @updatedAt

  @@index([driver_id])
  @@index([branch_id])
  @@map("go_vehicles")
}

/// Vehicle may serve multiple ride categories; dispatch matches if the ride category is in this set.
model GoVehicleRideCategory {
  id               String         @id @default(uuid())
  vehicle_id       String
  vehicle          GoVehicle      @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  ride_category_id String
  ride_category    GoRideCategory @relation(fields: [ride_category_id], references: [id])

  @@unique([vehicle_id, ride_category_id])
  @@index([ride_category_id])
  @@map("go_vehicle_ride_categories")
}

model GoVehicleCapability {
  id         String                @id @default(uuid())
  vehicle_id String
  vehicle    GoVehicle             @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  type       GoRideRequirementType

  @@unique([vehicle_id, type])
  @@map("go_vehicle_capabilities")
}

/// Operational / dispatch config (Ticket §7.2). Values are dashboard-managed — no hard-codes in logic.
model GoDispatchConfig {
  id                                   String   @id @default("default")
  batch_size                           Int      @default(3)
  batch_timeout_seconds                Int      @default(10)
  max_search_radius_m                  Int      @default(5000)
  radius_steps_json                    Json
  /// Fixed driver offer / map-circle radius (Option A). Offers only within this distance of pickup.
  driver_offer_radius_m                Int      @default(500)
  /// Keep SEARCHING at least this long before FAILED_NO_DRIVER when no candidates (same radius).
  min_search_seconds                   Int      @default(90)
  /// Delay between empty-candidate SEARCH_TICK retries while under min_search_seconds.
  empty_search_retry_seconds           Int      @default(10)
  busy_driver_max_eta_sec              Int      @default(300)
  scheduled_busy_to_pickup_max_eta_sec Int      @default(180)
  scheduled_required_early_arrival_sec Int      @default(120)
  pickup_arrival_radius_m              Int      @default(10)
  stale_location_seconds               Int      @default(60)
  long_stop_seconds                    Int      @default(600)
  /// Max distance (m) from planned route before MAJOR_ROUTE_DEVIATION (Ticket §12.6).
  route_deviation_max_m                Int      @default(300)
  scheduled_reminder_seconds           Int      @default(3600)
  scheduled_online_required_seconds    Int      @default(1800)
  scheduled_late_tolerance_seconds     Int      @default(300)
  updated_at                           DateTime @updatedAt

  @@map("go_dispatch_config")
}

// =====================================================================
// PHASE 2 — Ride Core
// =====================================================================

enum GoRideType {
  IMMEDIATE
  SCHEDULED
}

enum GoRideStatus {
  SEARCHING
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_DRIVER
  CANCELLED_BY_STAFF
  NO_SHOW
  INTERRUPTED
  REPLACED
  FAILED_NO_DRIVER
}

enum GoCancelActorRole {
  CUSTOMER
  DRIVER
  STAFF
}

enum GoPaymentMethod {
  CASH
  SHAM_CASH
  WALLET
}

/// Cash collection state (Ticket §21.1). No customer receipt.
enum GoPaymentStatus {
  PENDING
  CASH_EXPECTED
  COLLECTED
  WAIVED
}

/// When a discount and a compensation both exist, staff must choose (Ticket §44).
enum GoFareStackDecision {
  PENDING
  DISCOUNT_ONLY
  COMPENSATION_ONLY
  BOTH
}

enum GoBookingFor {
  SELF
  OTHER
}

enum GoDriverAvailability {
  OFFLINE
  ONLINE
  BUSY
}

model GoRide {
  id                           String                        @id @default(uuid())
  public_number                String                        @unique
  customer_id                  String
  customer                     GoCustomerProfile             @relation("CustomerRides", fields: [customer_id], references: [id])
  driver_id                    String?
  driver                       GoDriverProfile?              @relation("DriverRides", fields: [driver_id], references: [id])
  /// Driver's active vehicle when the ride was assigned.
  vehicle_id                   String?
  vehicle                      GoVehicle?                    @relation(fields: [vehicle_id], references: [id], onDelete: SetNull)
  /// { plate_number, make, model, color, year } copied at assignment so later vehicle edits do not rewrite history.
  vehicle_snapshot             Json?
  branch_id                    String
  branch                       GoBranch                      @relation(fields: [branch_id], references: [id])
  ride_category_id             String
  ride_category                GoRideCategory                @relation(fields: [ride_category_id], references: [id])
  /// Booking service (Ticket §29 / FLEET). DAILY default; TOURIST/FLEET support multi-vehicle pricing.
  service_code                 GoServiceCode                 @default(DAILY)
  service                      GoService                     @relation(fields: [service_code], references: [code])
  /// Passenger headcount (required for TOURIST). Null for DAILY when the app does not send it.
  passengers_count             Int?
  /// Vehicles requested. Fare is scaled by this for TOURIST / FLEET random; mix uses fleet_vehicles.
  vehicles_count               Int                           @default(1)
  /// FLEET: true = random category mix (reference fare × vehicles_count).
  random_vehicles              Boolean                       @default(false)
  /// FLEET mix: [{ ride_category_id, count }]. Null for random / non-fleet.
  fleet_vehicles               Json?
  type                         GoRideType
  status                       GoRideStatus
  payment_method               GoPaymentMethod               @default(CASH)
  payment_status               GoPaymentStatus               @default(CASH_EXPECTED)
  /// Null when discount and compensation do not both apply.
  fare_stack_decision          GoFareStackDecision?
  booking_for                  GoBookingFor                  @default(SELF)
  other_passenger_name         String?
  /// Never sent to drivers (responses, offers or socket events).
  other_passenger_phone        String?
  /// Name on the pickup sign; OTHER bookings only.
  pickup_sign_name             String?                       @db.VarChar(60)
  share_tracking_link          Boolean                       @default(false)
  /// Bearer secret of the public tracking page (/t/:token). Omitted from every query unless selected.
  tracking_token               String?                       @unique @db.VarChar(64)
  /// Free-text note from the customer to the driver.
  customer_note                String?                       @db.VarChar(150)
  /// ISO 639-1 code the customer wants the driver to speak (e.g. ar, en, fr).
  /// VIP category and TOURIST service: required — dispatch only offers matching drivers.
  /// Other rides: soft preference (matching drivers ranked first).
  preferred_driver_language    String                        @default("ar") @db.VarChar(16)
  scheduled_at                 DateTime?
  /// When dispatch search clock started (IMMEDIATE ≈ create; SCHEDULED / re-search = send / re-enter SEARCHING).
  search_started_at            DateTime?
  /// RENTAL booked end (chauffeur hire window). Null for non-rental rides.
  rental_ends_at               DateTime?
  pickup_lat                   Decimal                       @db.Decimal(10, 7)
  pickup_lng                   Decimal                       @db.Decimal(10, 7)
  pickup_address               String?
  /// How the customer set the pickup: PIN | GPS | SEARCH | SAVED_PLACE. Null on older rides.
  pickup_source                String?                       @db.VarChar(32)
  /// Last time pickup lat/lng/address changed after creation (null = never amended).
  pickup_updated_at            DateTime?
  /// H3 res-9 cell of the pickup, used by Radar demand aggregation. Older rides are backfilled by the radar tick.
  pickup_h3                    String?                       @db.VarChar(16)
  original_destination_lat     Decimal                       @db.Decimal(10, 7)
  original_destination_lng     Decimal                       @db.Decimal(10, 7)
  original_destination_address String?
  actual_start_lat             Decimal?                      @db.Decimal(10, 7)
  actual_start_lng             Decimal?                      @db.Decimal(10, 7)
  actual_dropoff_lat           Decimal?                      @db.Decimal(10, 7)
  actual_dropoff_lng           Decimal?                      @db.Decimal(10, 7)
  estimated_distance_m         Int?
  estimated_duration_sec       Int?
  estimated_fare               Decimal?                      @db.Decimal(18, 2)
  estimated_route_polyline     String?
  estimated_route_source       String?
  estimated_route_summary      String?
  /// Driver → pickup distance (m) captured at assignment. Live ETA may still update in apps.
  to_pickup_distance_m         Int?
  actual_distance_m            Int?
  actual_duration_sec          Int?
  billable_waiting_sec         Int                           @default(0)
  gross_final_fare             Decimal?                      @db.Decimal(18, 2)
  discount_total               Decimal?                      @db.Decimal(18, 2)
  compensation_total           Decimal?                      @db.Decimal(18, 2)
  customer_payable             Decimal?                      @db.Decimal(18, 2)
  /// Amount currently taken from the customer wallet for a WALLET ride (held at creation, trued-up at completion).
  wallet_paid_amount           Decimal                       @default(0) @db.Decimal(18, 2)
  assigned_at                  DateTime?
  arrived_at                   DateTime?
  started_at                   DateTime?
  completed_at                 DateTime?
  cancelled_at                 DateTime?
  no_show_at                   DateTime?
  cancel_actor_role            GoCancelActorRole?
  cancel_reason_code           String?
  cancel_reason_text           String?
  cancel_score_event           String?
  replacement_of_ride_id       String?
  replacement_of_ride          GoRide?                       @relation("RideReplacement", fields: [replacement_of_ride_id], references: [id])
  replacement_rides            GoRide[]                      @relation("RideReplacement")
  /// Rates fixed at creation { base_fare, price_per_km, price_per_minute, minimum_fare, night_pct, currency }.
  /// Completion and re-pricing read it so later price edits do not change this ride. Null on older rides.
  pricing_snapshot             Json?
  /// Driver bonus (% of the gross fare) paid by the company on completion. Null = no bonus.
  incentive_percentage         Decimal?                      @db.Decimal(5, 2)
  /// REJECTION | DISTANCE | REJECTION+DISTANCE — which rule set incentive_percentage.
  incentive_reason             String?                       @db.VarChar(40)
  /// Set once enough different drivers declined (or let expire) this ride's offers.
  incentive_rejection_pct      Decimal?                      @db.Decimal(5, 2)
  /// Set at creation when the pickup is far from the branch centre.
  incentive_distance_pct       Decimal?                      @db.Decimal(5, 2)
  created_at                   DateTime                      @default(now())
  updated_at                   DateTime                      @updatedAt
  stops                        GoRideStop[]
  requirements                 GoRideRequirement[]
  offers                       GoRideOffer[]
  alerts                       GoOperationalAlert[]
  complaints                   GoComplaint[]
  emergencies                  GoEmergencySession[]
  cases                        GoRideCase[]                  @relation("CaseOriginalRide")
  replacement_for_cases        GoRideCase[]                  @relation("CaseReplacementRide")
  entitlements                 GoDriverEntitlement[]
  wallet_transactions          GoDriverWalletTransaction[]
  customer_wallet_transactions GoCustomerWalletTransaction[]
  commission_hold              GoWalletCommissionHold?
  compensations                GoRideCompensation[]
  score_ledger                 GoPassportScoreLedger[]
  driver_score_ledger          GoDriverPassportScoreLedger[]
  discount_reservation         GoRideDiscountReservation?
  ratings                      GoRideRating[]
  messages                     GoRideMessage[]
  incentive_grants             GoDriverIncentiveGrant[]

  @@index([customer_id, status])
  @@index([driver_id, status])
  @@index([branch_id, status])
  @@index([status, created_at])
  @@index([type, scheduled_at])
  @@index([replacement_of_ride_id])
  @@index([service_code, status])
  @@index([pickup_h3, created_at])
  @@index([branch_id, created_at])
  @@map("go_rides")
}

model GoRideStop {
  id              String    @id @default(uuid())
  ride_id         String
  ride            GoRide    @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  sequence        Int
  latitude        Decimal   @db.Decimal(10, 7)
  longitude       Decimal   @db.Decimal(10, 7)
  address         String?
  arrived_at      DateTime?
  departed_at     DateTime?
  waiting_seconds Int       @default(0)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@unique([ride_id, sequence])
  @@index([ride_id])
  @@map("go_ride_stops")
}

model GoRideRequirement {
  id         String                @id @default(uuid())
  ride_id    String
  ride       GoRide                @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  type       GoRideRequirementType
  created_at DateTime              @default(now())

  @@unique([ride_id, type])
  @@map("go_ride_requirements")
}

// =====================================================================
// PHASE 6 (ticket body) — Ratings (Ticket §11)
// =====================================================================

enum GoRatingDirection {
  CUSTOMER_TO_DRIVER
  DRIVER_TO_CUSTOMER
}

model GoRideRating {
  id           String               @id @default(uuid())
  ride_id      String
  ride         GoRide               @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  direction    GoRatingDirection
  from_user_id String
  from_user    User                 @relation("RatingFromUser", fields: [from_user_id], references: [id])
  to_user_id   String
  to_user      User                 @relation("RatingToUser", fields: [to_user_id], references: [id])
  stars        Int
  notes        String?
  created_at   DateTime             @default(now())
  reasons      GoRideRatingReason[]

  @@unique([ride_id, direction])
  @@index([from_user_id])
  @@index([to_user_id])
  @@map("go_ride_ratings")
}

model GoRideRatingReason {
  id          String       @id @default(uuid())
  rating_id   String
  rating      GoRideRating @relation(fields: [rating_id], references: [id], onDelete: Cascade)
  reason_code String
  created_at  DateTime     @default(now())

  @@index([rating_id])
  @@map("go_ride_rating_reasons")
}

// =====================================================================
// Customer <-> driver chat, scoped to one ride
// =====================================================================

enum GoChatSenderRole {
  CUSTOMER
  DRIVER
}

enum GoChatMessageType {
  TEXT
  IMAGE
  VOICE
}

model GoRideMessage {
  id             String            @id @default(uuid())
  /// Insertion order; `after_id` / `up_to_id` cursors compare on this, never on the uuid.
  seq            Int               @unique @default(autoincrement())
  ride_id        String
  ride           GoRide            @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  /// Sender-generated 32-hex id; a resend with the same id returns the stored message.
  client_id      String            @db.VarChar(32)
  sender_role    GoChatSenderRole
  sender_user_id String
  sender_user    User              @relation(fields: [sender_user_id], references: [id])
  type           GoChatMessageType
  text           String?           @db.VarChar(1000)
  /// File name under storage/chat-media, e.g. `<id>.m4a`.
  media_key      String?
  media_mime     String?           @db.VarChar(40)
  duration_sec   Int?
  created_at     DateTime          @default(now())
  read_at        DateTime?

  @@unique([ride_id, sender_role, client_id])
  @@index([ride_id, seq])
  @@map("go_ride_messages")
}

model GoDriverState {
  driver_id        String               @id
  driver           GoDriverProfile      @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  availability     GoDriverAvailability @default(OFFLINE)
  last_lat         Decimal?             @db.Decimal(10, 7)
  last_lng         Decimal?             @db.Decimal(10, 7)
  h3_index         String?
  last_location_at DateTime?
  current_ride_id  String?
  next_ride_id     String?
  updated_at       DateTime             @updatedAt

  @@index([h3_index])
  @@index([availability, h3_index])
  @@map("go_driver_states")
}

// =====================================================================
// PHASE 3 — Dispatch / Ride Offers (Ticket §7)
// =====================================================================

enum GoRideOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  TAKEN_BY_OTHER
}

model GoRideOffer {
  id                String            @id @default(uuid())
  ride_id           String
  ride              GoRide            @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  driver_id         String
  driver            GoDriverProfile   @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  batch_number      Int
  radius_m          Int
  status            GoRideOfferStatus @default(PENDING)
  offered_at        DateTime          @default(now())
  expires_at        DateTime
  responded_at      DateTime?
  effective_eta_sec Int?

  @@unique([ride_id, driver_id])
  @@index([ride_id, status])
  @@index([driver_id, status])
  @@map("go_ride_offers")
}

// =====================================================================
// PHASE 4 — Scheduled engine alerts (subset of Ticket §12; full monitoring = Phase 5/7)
// =====================================================================

enum GoOperationalAlertType {
  LONG_STOP
  LOCATION_STALE
  MAJOR_ROUTE_DEVIATION
  SCHEDULED_DRIVER_OFFLINE
  SCHEDULED_DRIVER_DELAY
  URGENT_COMPLAINT
  EMERGENCY
  /// Command Center: unassigned requests in an area exceed nearby available drivers. No ride_id.
  DRIVER_COVERAGE_LOW
  /// Command Center: an immediate request has been SEARCHING longer than the threshold.
  ASSIGNMENT_DELAYED
  /// Command Center: an IN_PROGRESS ride is well past its estimated duration.
  RIDE_DELAYED
  /// Command Center: branch cancellation rate over the recent window exceeds the threshold. No ride_id.
  CANCELLATION_RATE_HIGH
  /// Driver reported breakdown/accident — CS must assign a replacement driver (or re-dispatch before pickup).
  REPLACEMENT_NEEDED
}

enum GoOperationalAlertStatus {
  OPEN
  /// Acknowledged by a staff member.
  CLAIMED
  RESOLVED
}

enum GoAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model GoOperationalAlert {
  id            String                   @id @default(uuid())
  /// Null for area / branch alerts raised by the Command Center (coverage, cancellation rate).
  ride_id       String?
  ride          GoRide?                  @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  branch_id     String
  branch        GoBranch                 @relation(fields: [branch_id], references: [id])
  type          GoOperationalAlertType
  severity      GoAlertSeverity          @default(WARNING)
  /// H3 cell of the area the alert is about (coverage alerts).
  h3_cell       String?                  @db.VarChar(16)
  /// What was measured and the configured limit it crossed (Command Center alerts).
  measured_value Decimal?                @db.Decimal(12, 2)
  threshold     Decimal?                 @db.Decimal(12, 2)
  /// Same key inside the dedupe window returns the existing alert instead of a new one.
  dedupe_key    String?                  @db.VarChar(160)
  status        GoOperationalAlertStatus @default(OPEN)
  occurrence_no Int?
  started_at    DateTime                 @default(now())
  resolved_at   DateTime?
  claimed_by_id String?
  claimed_by    User?                    @relation(fields: [claimed_by_id], references: [id])
  claimed_at    DateTime?
  auto_resolved Boolean                  @default(false)
  metadata      Json?
  created_at    DateTime                 @default(now())
  updated_at    DateTime                 @updatedAt

  @@index([status, type])
  @@index([ride_id, type, status])
  @@index([branch_id, status])
  @@index([dedupe_key, created_at])
  @@map("go_operational_alerts")
}

/// Command Center alert thresholds (single row "default"). Admin-edited; every change is audited.
model GoCommandCenterConfig {
  id                           String   @id @default("default")
  alerts_enabled               Boolean  @default(true)
  /// Coverage alert: at least this many unassigned requests in one area, and more requests than nearby available drivers.
  coverage_min_unassigned      Int      @default(3)
  /// Assignment alert: an immediate request still SEARCHING after this many seconds.
  assignment_delay_seconds     Int      @default(180)
  /// Delayed ride: elapsed > estimated_duration × factor AND elapsed > estimated + min_extra.
  ride_delay_factor            Decimal  @default(1.5) @db.Decimal(4, 2)
  ride_delay_min_extra_seconds Int      @default(600)
  /// Cancellation alert: cancelled ÷ finished rides created in the window, once at least min_rides finished.
  cancellation_rate_pct        Decimal  @default(30) @db.Decimal(5, 2)
  cancellation_window_minutes  Int      @default(60)
  cancellation_min_rides       Int      @default(10)
  /// A repeat of the same alert key within this window is not raised again.
  dedupe_minutes               Int      @default(30)
  updated_at                   DateTime @updatedAt

  @@map("go_command_center_config")
}

// =====================================================================
// PHASE 6 — Complaints / Emergency (Ticket §14–15)
// =====================================================================

enum GoComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum GoComplaintPriority {
  NORMAL
  URGENT
}

model GoComplaint {
  id                    String              @id @default(uuid())
  ride_id               String
  ride                  GoRide              @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  customer_id           String
  customer              GoCustomerProfile   @relation(fields: [customer_id], references: [id])
  driver_id             String?
  driver                GoDriverProfile?    @relation(fields: [driver_id], references: [id])
  branch_id             String
  branch                GoBranch            @relation(fields: [branch_id], references: [id])
  priority              GoComplaintPriority @default(NORMAL)
  status                GoComplaintStatus   @default(OPEN)
  reason_code           String
  notes                 String?
  staff_notes           String?
  submitted_during_ride Boolean             @default(false)
  assigned_to_id        String?
  assigned_to           User?               @relation("ComplaintAssignee", fields: [assigned_to_id], references: [id])
  resolved_by_id        String?
  resolved_by           User?               @relation("ComplaintResolver", fields: [resolved_by_id], references: [id])
  resolved_at           DateTime?
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt

  @@index([branch_id, status])
  @@index([ride_id])
  @@index([priority, status])
  @@index([customer_id, created_at])
  @@map("go_complaints")
}

/// General (non-ride) support inbox from the customer account (Ticket §26).
enum GoSupportMessageStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model GoSupportMessage {
  id           String                 @id @default(uuid())
  /// Public short code shown to the customer (e.g. SUP-A1B2C3D4).
  reference    String                 @unique @db.VarChar(20)
  /// Exactly one of customer_id / driver_id is set.
  customer_id  String?
  customer     GoCustomerProfile?     @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  driver_id    String?
  driver       GoDriverProfile?       @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  full_name    String                 @db.VarChar(120)
  phone        String                 @db.VarChar(32)
  email        String?                @db.VarChar(254)
  message      String                 @db.VarChar(2000)
  status       GoSupportMessageStatus @default(OPEN)
  claimed_by_id String?
  claimed_by   User?                  @relation("SupportMessageClaimedBy", fields: [claimed_by_id], references: [id], onDelete: SetNull)
  reply        String?                @db.VarChar(4000)
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt
  closed_at    DateTime?

  @@index([customer_id, created_at])
  @@index([driver_id, created_at])
  @@index([status, created_at])
  @@map("go_support_messages")
}

enum GoEmergencyStatus {
  ACTIVE
  HANDLED
  CLOSED
}

enum GoEmergencyStartedBy {
  CUSTOMER
  DRIVER
}

enum GoEmergencyRecordingStatus {
  LIVE
  PENDING_DECISION
  SAVED
  DELETED
}

model GoEmergencySession {
  id                    String                     @id @default(uuid())
  ride_id               String
  ride                  GoRide                     @relation(fields: [ride_id], references: [id], onDelete: Cascade)
  customer_id           String
  customer              GoCustomerProfile          @relation(fields: [customer_id], references: [id])
  branch_id             String
  branch                GoBranch                   @relation(fields: [branch_id], references: [id])
  status                GoEmergencyStatus          @default(ACTIVE)
  /// Who pressed SOS first (shared session — second party gets already_active).
  started_by            GoEmergencyStartedBy       @default(CUSTOMER)
  started_at            DateTime                   @default(now())
  ended_at              DateTime?
  started_lat           Decimal?                   @db.Decimal(10, 7)
  started_lng           Decimal?                   @db.Decimal(10, 7)
  /// Latest position sent while the session is open (starts at started_lat/lng).
  last_lat              Decimal?                   @db.Decimal(10, 7)
  last_lng              Decimal?                   @db.Decimal(10, 7)
  last_location_at      DateTime?
  /// When customer service claimed it; null if it was closed without a claim.
  claimed_at            DateTime?
  handled_by_id         String?
  handled_by            User?                      @relation("EmergencyHandler", fields: [handled_by_id], references: [id])
  recording_status      GoEmergencyRecordingStatus @default(LIVE)
  recording_storage_key String?
  saved_by_id           String?
  saved_by              User?                      @relation("EmergencySaver", fields: [saved_by_id], references: [id])
  saved_at              DateTime?
  deleted_by_id         String?
  deleted_by            User?                      @relation("EmergencyDeleter", fields: [deleted_by_id], references: [id])
  deleted_at            DateTime?
  created_at            DateTime                   @default(now())
  updated_at            DateTime                   @updatedAt

  @@index([branch_id, status])
  @@index([ride_id])
  @@map("go_emergency_sessions")
}

// =====================================================================
// PHASE 7 — Incidents / Replacement / Entitlement (Ticket §16–18)
// =====================================================================

enum GoCaseType {
  ACCIDENT
  BREAKDOWN
}

enum GoCaseStatus {
  OPEN
  IN_REVIEW
  CLOSED
}

enum GoAccidentSeverity {
